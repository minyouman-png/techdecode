rules_version = '2';

// menewsoft.com 게시판(/board/) 접근 규칙.
//
// ⚠️★정적 사이트(GitHub Pages)라 **서버가 없다.** 브라우저가 Firestore 를 직접 부르므로
//   "누가 무엇을 할 수 있는가"를 지키는 것은 오직 이 파일이다. 클라이언트 JS 의 검사는
//   사용자 편의일 뿐 보호가 아니다(F12 로 우회 가능). 그래서 길이 제한·작성자 일치 같은
//   조건을 **여기에서도 다시** 건다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 운영자 = 이 계정 하나(minyouman@gmail.com / 김민유).
    // ⚠️★**이메일이 아니라 UID 로** 판정한다. 처음엔 이메일이었는데(첫 로그인 전에는 UID 를
    //   알 수 없어서), 2026-08-28 첫 로그인으로 UID 를 확보한 뒤 바꿨다. UID 는 이 프로젝트
    //   안에서 불변이지만 구글 계정의 이메일은 사용자가 바꿀 수 있다 — 그날 운영자 권한이
    //   조용히 사라진다. 운영자를 늘리려면 이 목록에 UID 를 추가하면 된다.
    function isAdmin() {
      return signedIn() && request.auth.uid in ['wj7sXdNgssea8DqOSYK23XgX0Pq1'];
    }

    // 카테고리는 셋뿐이고, **공지는 운영자만** 쓸 수 있다.
    // ⚠️이 판정이 규칙에 없으면 아무나 글을 공지로 올려 목록 맨 위에 고정시킬 수 있다
    //   (화면의 '공지' 선택지를 운영자에게만 보여주는 것은 보호가 아니다 — F12 로 뚫린다).
    function catOk(c) {
      return c is string && (c in ['free', 'qna'] || (c == 'notice' && isAdmin()));
    }

    // 이 사람이 설정한 닉네임. 없으면 get() 이 실패해 글쓰기가 막힌다 —
    // ★그게 '닉네임부터 설정' 규칙의 실체다(화면의 안내창은 거들 뿐이다).
    function myNick() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nick;
    }

    // 닉네임 규칙. ⚠️'운영자'·'미뉴소프트' 같은 이름을 아무나 쓰면 공지를 사칭할 수 있어서 막는다
    //   (운영자 본인은 예외 — 아래 users 규칙에서 isAdmin() 으로 열어 준다).
    function nickOk(n) {
      return n is string && n.size() >= 2 && n.size() <= 20
          && !n.matches('(?i).*(운영자|관리자|미뉴소프트|menewsoft|admin).*');
    }

    // 글·댓글 공통: 작성자를 자기 자신으로만 쓸 수 있고, 시각은 서버 시각이어야 한다.
    // ⚠️createdAt 을 클라이언트가 정하게 두면 목록 정렬(작성시각 역순)을 조작할 수 있다.
    // ⚠️★authorName 은 **저장된 닉네임과 같아야** 한다. 화면이 보내는 값을 그대로 믿으면
    //   API 를 직접 불러 남의 이름으로 글을 쓸 수 있다(닉네임 제도가 장식이 된다).
    function authorOk(d) {
      return d.authorUid == request.auth.uid
          && d.authorName == myNick()
          && d.createdAt == request.time;
    }

    // 사용자 프로필 = 닉네임 한 칸. 목록·본문에는 글에 박아 둔 authorName 이 쓰이므로
    // 이 문서는 '내 닉네임이 무엇인가'와 중복 확인용으로만 읽는다.
    // ── 조스프로젝트1: 롤링다이스 주문예약 ────────────────────────────────
    //
    // ⚠️★여기엔 **배송정보(이름·전화·주소)** 가 들어간다. 게시판과 달리 공개 데이터가
    //   아니므로 read 조차 열지 않는다. 정적 사이트라 서버가 없고, 이 규칙이 유일한
    //   보호막이다 — 화면의 아이디/비밀번호 입력창은 Firebase 인증으로 실제 계정을
    //   확인하는 것이지 장식이 아니지만, **보호하는 것은 이 규칙**이다.
    //
    // 예약자 = dsl@menewsoft.com 계정 하나. 운영자도 함께 열어 둔다(사고 수습용).
    function isReserver() {
      return signedIn() && request.auth.uid in ['yQrF5CDdm0RkCla6Kh0a0OIsD6A2'];
    }

    // ⚠️★**배송정보는 여기 들어올 수 없다**(2026-09-08). 주소를 웹에서 정하게 두면
    //   아이디·비밀번호를 아는 사람이 물건을 자기 주소로 보내게 만들 수 있고, 과거
    //   예약에 남은 주소가 그대로 읽힌다. 주소의 유일한 출처는 맥의 config.json 이다.
    //   화면에서 입력칸을 없애는 것은 보호가 아니다(F12 로 직접 쓸 수 있다) — 그래서
    //   **필드 자체를 규칙에서 거부**한다. 맥 실행기도 예약 문서의 주소를 읽지 않는다.
    function noShipping() {
      return !request.resource.data.keys().hasAny(['shipping']);
    }

    match /reservations/{resId} {
      allow read, delete: if isReserver() || isAdmin();
      allow create, update: if (isReserver() || isAdmin()) && noShipping();
    }

    // 맥에서 도는 실행기가 살아 있는지 알리는 한 칸. 이게 멎어 있으면 예약을 걸어도
    // 아무도 주문하지 않는다 — 화면이 그 사실을 감추지 않도록 따로 둔다.
    match /workers/{workerId} {
      allow read, write: if isReserver() || isAdmin();
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'createdAt', 'updatedAt'])
        && (nickOk(request.resource.data.nick) || isAdmin());
      allow delete: if false;
    }

    match /posts/{postId} {
      // 보는 건 누구나 — 로그인하지 않아도 목록과 본문을 읽는다.
      allow read: if true;

      allow create: if signedIn()
        && authorOk(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.commentCount == 0
        && catOk(request.resource.data.cat);

      allow update: if signedIn() && (
        // ① 본인 글 수정 — 제목·본문·카테고리만. 작성자나 작성시각은 바꿀 수 없다.
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'cat', 'updatedAt'])
          && catOk(request.resource.data.cat)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 10000
        )
        // ② 댓글 수 카운터 — 남의 글에도 댓글을 달 수 있어야 하므로 로그인한 사람이면
        //    **commentCount 한 칸만** 건드릴 수 있게 연다. 최악의 경우 숫자가 틀어질 뿐
        //    글·댓글 내용은 손댈 수 없다(목록에 댓글 수를 보여주려면 이 방법뿐이다 —
        //    글마다 댓글을 세면 목록 한 번에 조회가 20번 더 나간다).
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
      );

      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && authorOk(request.resource.data)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;

        // 댓글 수정은 없다(짧은 글이라 지우고 다시 쓰면 된다).
        allow update: if false;

        // 댓글 작성자 본인, 운영자, 그리고 **그 글의 글쓴이**가 지울 수 있다.
        // ⚠️글쓴이 판정은 부모 글을 한 번 읽는다(get). 그래서 글을 지울 때는
        //   클라이언트가 **댓글을 먼저 지우고 글을 나중에** 지운다 — 순서가 반대면
        //   부모가 사라져 get 이 실패하고 댓글이 영영 안 지워진다.
        allow delete: if isAdmin()
          || (signedIn() && resource.data.authorUid == request.auth.uid)
          || (signedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
      }
    }
  }
}
