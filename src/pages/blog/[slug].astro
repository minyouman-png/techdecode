---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, type Lang } from '../../i18n/ui';
import { useTranslations, blogUrl } from '../../i18n/utils';
import { categoryLabel, categoryUrl } from '../../i18n/categories';
import RelatedBlock from '../../components/RelatedBlock.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  return all
    .filter((p) => p.data.lang === 'ko')
    .map((post) => {
      const alternates: Partial<Record<Lang, string>> = {};
      for (const code of Object.keys(languages) as Lang[]) {
        if (all.some((p) => p.data.key === post.data.key && p.data.lang === code)) {
          alternates[code] = blogUrl(post.data.key, code);
        }
      }
      return { params: { slug: post.data.key }, props: { post, alternates } };
    });
}

const { post, alternates } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const t = useTranslations('ko');
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
// 글마다 제목을 새긴 공유 카드 이미지(tools/make_og.py 로 생성).
const ogImage = `/og/blog/${d.key}.en.png`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: 'ko',
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: 'Tech Decode' },
  image: new URL(ogImage, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(d.category ? { articleSection: d.category } : {}),
};
---
<BaseLayout lang="ko" title={d.title} description={d.description} alternates={alternates} image={ogImage} noindex={true}>
  <article class="article">
    <div class="wrap">
      <div class="article-head">
        {d.category && <a class="cat" href={categoryUrl(d.category, 'ko')}>{categoryLabel(d.category, 'ko')}</a>}
        <h1>{d.title}</h1>
        <p class="post-meta">By {d.author} · {dateStr}</p>
      </div>
      <div class="ad-slot" data-ad-slot="article-top"></div>
      <div class="post-body"><Content /></div>
      <p class="disclosure">{t('disclosure')}</p>
      <RelatedBlock lang="ko" currentKey={d.key} category={d.category} />
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
