---
// 게임 한 편의 소개·공략 페이지(`/guide/<slug>/`) — 한국어 전용.
// 내용의 원본은 `src/i18n/guides.ts` 하나뿐이다. 여기엔 문구를 직접 적지 않는다.
// ⚠️문자열 안의 <b>·<a> 는 우리가 쓴 고정 문구라 set:html 로 그린다(방문자 입력은 여기 오지 않는다 —
//   방문자 글은 GuideCommunity 가 esc() 를 거쳐 그린다).
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCommunity from './GuideCommunity.astro';
import { guides, guideUrl, TESTER_GROUP_URL, type Guide } from '../i18n/guides';

interface Props { guide: Guide }
const { guide: g } = Astro.props;
const others = guides.filter((x) => x.slug !== g.slug);

const toc = [
  ['intro', '게임 소개'],
  g.playUrl ? ['join', '설치 방법'] : null,
  ['story', '이야기'],
  ['controls', '조작법'],
  ['systems', '핵심 시스템'],
  g.foes.length ? ['foes', g.foesTitle] : null,
  ['tips', '초보자 공략'],
  ['faq', '자주 묻는 질문'],
  ['community', '커뮤니티'],
].filter(Boolean) as [string, string][];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: g.title,
    alternateName: g.fullTitle,
    description: g.metaDesc,
    genre: g.genre,
    gamePlatform: g.platform,
    operatingSystem: 'Android',
    applicationCategory: 'Game',
    image: new URL(g.hero, Astro.site).href,
    author: { '@type': 'Organization', name: 'MeNew Soft', url: Astro.site?.href },
    inLanguage: 'ko',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---
<BaseLayout lang="ko" titleFull={g.metaTitle} description={g.metaDesc} image={g.hero} jsonLd={jsonLd}>
  <div class="gd" style={`--gc:${g.color}`}>
    <section class="gd-hero">
      <img class="gd-hero-bg" src={g.hero} alt="" />
      <div class="gd-hero-shade"></div>
      <div class="wrap gd-hero-in">
        <a class="gd-crumb" href="/guide/">← 게임 공략</a>
        <div class="gd-title-row">
          <img class="gd-icon" src={g.icon} alt={`${g.title} 아이콘`} width="88" height="88" />
          <div>
            <p class="gd-kick">{g.genre}</p>
            <h1>{g.title}</h1>
            <p class="gd-sub">{g.subtitle}</p>
          </div>
        </div>
        <p class="gd-tagline">{g.tagline}</p>
        <div class="gd-cta">
          {g.playUrl && <a class="gd-btn" href="#join">▶ 테스트 참여하고 설치</a>}
          <a class="gd-btn gd-btn-ghost" href="#community">💬 커뮤니티</a>
          <a class="gd-btn gd-btn-ghost" href="#tips">📖 공략 바로 보기</a>
        </div>
      </div>
    </section>

    <div class="wrap gd-body">
      <nav class="gd-toc" aria-label="목차">
        {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

      <section id="intro" class="gd-sec">
        <h2>게임 소개</h2>
        {g.intro.map((p) => <p set:html={p} />)}
        <dl class="gd-facts">
          {g.facts.map(([k, v]) => (<div><dt>{k}</dt><dd set:html={v} /></div>))}
        </dl>
        {g.shots.length > 0 && (
          <div class:list={['gd-shots', { wide: g.shotsWide }]}>
            {g.shots.map((s) => (
              <figure>
                <img src={s.src} alt={s.cap} loading="lazy" />
                <figcaption>{s.cap}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {g.shotsNote && <p class="gd-note">{g.shotsNote}</p>}
      </section>

      {g.playUrl && (
        <section id="join" class="gd-sec">
          <h2>설치 방법 (Google Play 테스트)</h2>
          <p>지금은 정식 출시 전 <b>비공개 테스트</b> 기간입니다. 안드로이드 폰에서 아래 순서대로 하면 누구나 무료로 설치할 수 있습니다.</p>
          <ol class="gd-join">
            <li><b>테스터 그룹 가입</b> — <a href={TESTER_GROUP_URL} target="_blank" rel="noopener">Google 그룹 cnklab_tester</a>에 플레이 스토어와 같은 구글 계정으로 ‘그룹 가입’을 누릅니다.</li>
            <li><b>테스터 되기</b> — <a href={g.playUrl} target="_blank" rel="noopener">테스트 참여 페이지</a>에서 ‘테스터 되기’를 누릅니다.</li>
            <li><b>설치</b> — 같은 페이지의 ‘Google Play에서 다운로드’ 또는 플레이 스토어에서 「{g.title}」을 찾아 설치합니다. 반영까지 몇 분 걸릴 수 있습니다.</li>
          </ol>
          <div class="gd-cta">
            <a class="gd-btn" href={TESTER_GROUP_URL} target="_blank" rel="noopener">① 그룹 가입</a>
            <a class="gd-btn" href={g.playUrl} target="_blank" rel="noopener">② 테스트 참여</a>
          </div>
          <p class="gd-note">한 번 그룹에 가입하면 미뉴소프트의 다른 테스트 게임에도 같은 방법으로 참여할 수 있습니다. 테스트 기간의 의견은 아래 커뮤니티에 남겨 주세요.</p>
        </section>
      )}

      <section id="story" class="gd-sec">
        <h2>이야기</h2>
        {g.story.map((p) => <p set:html={p} />)}
        {g.people.length > 0 && (
          <div class="gd-people">
            {g.people.map((c) => (
              <div class="gd-person"><h3>{c.name}</h3><p set:html={c.desc} /></div>
            ))}
          </div>
        )}
        {g.chapters && g.chapters.length > 0 && (
          <>
            <h3 class="gd-h3">{g.chaptersTitle ?? '장 구성'}</h3>
            <ol class="gd-chapters">
              {g.chapters.map((c) => (<li><b>{c.name}</b><span set:html={c.desc} /></li>))}
            </ol>
          </>
        )}
        {g.spoiler && (
          <details class="gd-spoiler">
            <summary>⚠️ 결말 스포일러 펼치기</summary>
            {g.spoiler.map((p) => <p set:html={p} />)}
          </details>
        )}
      </section>

      <section id="controls" class="gd-sec">
        <h2>조작법</h2>
        <div class="gd-ctl-grid">
          {g.controls.map((c) => (
            <div class="gd-card">
              <h3>{c.title}</h3>
              <table class="gd-ctl">
                <tbody>
                  {c.rows.map(([k, v]) => (<tr><th set:html={k} /><td set:html={v} /></tr>))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </section>

      <section id="systems" class="gd-sec">
        <h2>핵심 시스템</h2>
        <div class="gd-sys">
          {g.systems.map((s) => (
            <article class="gd-card">
              <h3>{s.icon && <span class="gd-sys-ic">{s.icon}</span>}{s.title}</h3>
              <p set:html={s.body} />
              {s.points && <ul>{s.points.map((p) => <li set:html={p} />)}</ul>}
            </article>
          ))}
        </div>
        {g.tables?.map((t) => (
          <div class="gd-table-wrap">
            <h3 class="gd-h3">{t.title}</h3>
            <table class="gd-table">
              <thead><tr>{t.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{t.rows.map((r) => <tr>{r.map((c) => <td set:html={c} />)}</tr>)}</tbody>
            </table>
            {t.note && <p class="gd-note" set:html={t.note} />}
          </div>
        ))}
      </section>

      {g.foes.length > 0 && (
        <section id="foes" class="gd-sec">
          <h2>{g.foesTitle}</h2>
          <div class="gd-foes">
            {g.foes.map((f) => (
              <div class="gd-foe">
                <h3>{f.name}{f.where && <span class="gd-where">{f.where}</span>}</h3>
                <p set:html={f.desc} />
                {f.tip && <p class="gd-foe-tip"><b>공략</b> <span set:html={f.tip} /></p>}
              </div>
            ))}
          </div>
        </section>
      )}

      <section id="tips" class="gd-sec">
        <h2>초보자 공략</h2>
        <ol class="gd-tips">
          {g.tips.map((t) => <li set:html={t} />)}
        </ol>
      </section>

      <section id="faq" class="gd-sec">
        <h2>자주 묻는 질문</h2>
        {g.faq.map((f) => (
          <details class="gd-faq">
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </section>

      <section id="community" class="gd-sec">
        <GuideCommunity cats={[g.cat]} title={`${g.title} 커뮤니티`} />
      </section>

      <section class="gd-sec">
        <h2>다른 게임도 둘러보기</h2>
        <div class="gd-others">
          {others.map((o) => (
            <a class="gd-other" href={guideUrl(o.slug)} style={`--gc:${o.color}`}>
              <img src={o.icon} alt="" width="56" height="56" loading="lazy" />
              <span><b>{o.title}</b><small>{o.tagline}</small></span>
            </a>
          ))}
        </div>
        <p class="gd-note">
          이 공략은 개발팀이 게임 데이터와 설계 문서를 보고 직접 정리했습니다. 게임은 테스트 중이라 수치와 내용이
          업데이트로 바뀔 수 있습니다{g.updated && <> (공략 기준: {g.updated})</>}.
          {g.privacyUrl && <> · <a href={g.privacyUrl} target="_blank" rel="noopener">개인정보처리방침</a></>}
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .gd { --gcs: color-mix(in srgb, var(--gc) 14%, transparent); }
  .gd-hero { position: relative; overflow: hidden; color: #fff; min-height: 380px; display: flex; align-items: flex-end; }
  .gd-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gd-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,8,14,.25) 0%, rgba(6,8,14,.55) 45%, rgba(6,8,14,.92) 100%); }
  .gd-hero-in { position: relative; width: 100%; box-sizing: border-box; padding-top: 64px; padding-bottom: 34px; }
  .gd-crumb { color: rgba(255,255,255,.8); font-size: 14px; }
  .gd-crumb:hover { color: #fff; }
  .gd-title-row { display: flex; gap: 18px; align-items: center; margin: 16px 0 10px; }
  .gd-icon { border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,.45); flex: none; }
  .gd-kick { margin: 0 0 4px; font-size: 12px; font-weight: 700; letter-spacing: .08em; color: color-mix(in srgb, var(--gc) 40%, #fff); }
  .gd-hero h1 { margin: 0; font-family: var(--serif); font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.1; color: #fff; }
  .gd-sub { margin: 6px 0 0; color: rgba(255,255,255,.82); font-size: 1rem; }
  .gd-tagline { max-width: 640px; margin: 10px 0 20px; font-size: 1.08rem; color: rgba(255,255,255,.92); }
  .gd-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .gd-btn { display: inline-block; font-weight: 700; font-size: 15px; padding: 10px 18px; border-radius: 999px; background: var(--gc); color: #fff; border: 1px solid var(--gc); }
  .gd-btn:hover { filter: brightness(1.1); }
  .gd-btn-ghost { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.35); }

  .gd-body { padding-top: 22px; padding-bottom: 80px; }
  .gd-toc { position: sticky; top: 0; z-index: 5; display: flex; gap: 4px; overflow-x: auto; padding: 8px 0; margin-bottom: 8px; background: var(--bg); border-bottom: 1px solid var(--border); }
  .gd-toc a { white-space: nowrap; padding: 6px 12px; border-radius: 999px; font-size: 14px; color: var(--muted); }
  .gd-toc a:hover { color: var(--fg-strong); background: var(--gcs); }

  .gd-sec { padding: 34px 0 6px; scroll-margin-top: 56px; }
  .gd-sec h2 { font-family: var(--serif); font-size: 1.6rem; color: var(--fg-strong); margin: 0 0 16px; padding-left: 12px; border-left: 4px solid var(--gc); }
  .gd-sec > p { max-width: var(--readw); line-height: 1.8; }
  .gd-h3 { font-size: 1.12rem; color: var(--fg-strong); margin: 26px 0 12px; }
  .gd-sec :global(b) { color: var(--fg-strong); }

  .gd-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 20px 0; }
  .gd-facts div { border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; background: var(--gcs); }
  .gd-facts dt { font-size: 12px; color: var(--muted); font-weight: 700; }
  .gd-facts dd { margin: 3px 0 0; color: var(--fg-strong); font-weight: 600; font-size: .95rem; word-break: keep-all; }

  .gd-shots { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x mandatory; }
  .gd-shots figure { margin: 0; flex: none; width: 220px; scroll-snap-align: start; }
  .gd-shots img { width: 100%; border-radius: 12px; border: 1px solid var(--border); display: block; }
  .gd-shots.wide figure { width: 380px; }
  .gd-shots figcaption { font-size: 12.5px; color: var(--muted); margin-top: 6px; }

  .gd-join { margin: 0 0 16px; padding-left: 22px; max-width: var(--readw); line-height: 1.8; }
  .gd-join li { margin-bottom: 6px; }
  .gd-sec a:not(.gd-btn) { color: var(--gc); filter: brightness(1.15); text-decoration: underline; text-underline-offset: 3px; }
  .gd-people { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; margin-top: 16px; }
  .gd-person { border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
  .gd-person h3 { margin: 0 0 6px; font-size: 1.02rem; color: var(--gc); filter: brightness(1.15); }
  .gd-person p { margin: 0; color: var(--muted); font-size: .93rem; line-height: 1.65; }
  .gd-chapters { margin: 0; padding-left: 22px; }
  .gd-chapters li { margin: 0 0 8px; line-height: 1.6; }
  .gd-chapters b { margin-right: 8px; }
  .gd-chapters span { color: var(--muted); }
  .gd-spoiler { margin-top: 18px; border: 1px dashed var(--border); border-radius: 10px; padding: 10px 16px; }
  .gd-spoiler summary { cursor: pointer; font-weight: 700; color: var(--muted); }

  .gd-card { border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; background: color-mix(in srgb, var(--fg-strong) 3%, transparent); }
  .gd-card h3 { margin: 0 0 10px; font-size: 1.08rem; color: var(--fg-strong); display: flex; align-items: center; gap: 8px; }
  .gd-card p { margin: 0 0 8px; color: var(--fg); line-height: 1.7; font-size: .95rem; }
  .gd-card ul { margin: 6px 0 0; padding-left: 18px; color: var(--muted); font-size: .92rem; line-height: 1.7; }
  .gd-ctl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
  .gd-ctl { width: 100%; border-collapse: collapse; font-size: .93rem; }
  .gd-ctl th { text-align: left; white-space: nowrap; padding: 6px 12px 6px 0; color: var(--gc); filter: brightness(1.15); vertical-align: top; width: 1%; }
  .gd-ctl td { padding: 6px 0; color: var(--fg); border-bottom: 1px solid var(--border-soft); }
  .gd-ctl :global(kbd) { font-family: inherit; font-size: 12px; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; padding: 1px 6px; background: var(--bg-elev); color: var(--fg-strong); }
  .gd-sys { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
  .gd-sys-ic { font-size: 1.2rem; }

  .gd-table-wrap { overflow-x: auto; }
  .gd-table { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 480px; }
  .gd-table th { text-align: left; background: var(--gcs); color: var(--fg-strong); padding: 8px 10px; border-bottom: 1px solid var(--border); }
  .gd-table td { padding: 8px 10px; border-bottom: 1px solid var(--border-soft); vertical-align: top; }
  .gd-note { color: var(--faint); font-size: 13px; margin-top: 10px; line-height: 1.6; }

  .gd-foes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .gd-foe { border: 1px solid var(--border); border-left: 3px solid var(--gc); border-radius: 10px; padding: 14px 16px; }
  .gd-foe h3 { margin: 0 0 6px; font-size: 1.02rem; color: var(--fg-strong); display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .gd-where { font-size: 12px; font-weight: 600; color: var(--muted); }
  .gd-foe p { margin: 0 0 6px; color: var(--muted); font-size: .92rem; line-height: 1.65; }
  .gd-foe-tip { color: var(--fg) !important; }
  .gd-foe-tip b { color: var(--gc) !important; filter: brightness(1.15); margin-right: 4px; }

  .gd-tips { counter-reset: tip; list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; max-width: 820px; }
  .gd-tips li { counter-increment: tip; position: relative; padding: 12px 16px 12px 52px; border: 1px solid var(--border); border-radius: 12px; line-height: 1.7; }
  .gd-tips li::before { content: counter(tip); position: absolute; left: 14px; top: 12px; width: 26px; height: 26px; border-radius: 50%; background: var(--gc); color: #fff; font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center; }

  .gd-faq { border-bottom: 1px solid var(--border); padding: 12px 2px; max-width: 820px; }
  .gd-faq summary { cursor: pointer; font-weight: 700; color: var(--fg-strong); }
  .gd-faq p { margin: 8px 0 2px; color: var(--muted); line-height: 1.75; }

  .gd-others { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .gd-other { display: flex; gap: 14px; align-items: center; border: 1px solid var(--border); border-radius: 14px; padding: 12px 14px; color: var(--fg); }
  .gd-other:hover { border-color: var(--gc); }
  .gd-other img { border-radius: 14px; flex: none; }
  .gd-other b { display: block; color: var(--fg-strong); }
  .gd-other small { color: var(--muted); font-size: 13px; line-height: 1.5; display: block; }

  @media (max-width: 600px) {
    .gd-hero { min-height: 340px; }
    .gd-icon { width: 64px; height: 64px; border-radius: 16px; }
    .gd-sec h2 { font-size: 1.35rem; }
    .gd-shots figure { width: 180px; }
    .gd-shots.wide figure { width: 300px; }
  }
</style>
