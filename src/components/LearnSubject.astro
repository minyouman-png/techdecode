---
// 과목별 학습 페이지 (`/learn/<slug>/`). 한국어 전용.
import BaseLayout from '../layouts/BaseLayout.astro';
import LearnPractice from './LearnPractice.astro';
import LearnScripts from './LearnScripts.astro';
import { learnUi, countTopics, countVideos, subjectUrl, watchUrl, thumbUrl, subjects, emphasize, type LearnSubject } from '../i18n/learn';

interface Props { subject: LearnSubject; }
const { subject } = Astro.props;
const others = subjects.filter((s) => s.slug !== subject.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `초등 1학년 ${subject.title}`,
  description: subject.tagline,
  inLanguage: 'ko',
  educationalLevel: '초등학교 1학년',
  isAccessibleForFree: true,
  provider: { '@type': 'Organization', name: 'MeNew Soft', url: 'https://menewsoft.com/' },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT20M' },
  syllabusSections: subject.units.flatMap((u) =>
    u.topics.map((t) => ({ '@type': 'Syllabus', name: t.title, description: t.goal }))
  ),
};
---
<BaseLayout
  lang="ko"
  titleFull={`초등 1학년 ${subject.title} — ${subject.tagline}`}
  description={`초등학교 1학년 ${subject.title} 학습 정리. ${subject.tagline} 단원별 학습 영상 ${countVideos(subject)}개와 바로 풀어 보는 연습 문제.`}
  alternates={{ ko: subjectUrl(subject.slug) }}
  jsonLd={jsonLd}
>
  <section class="subj-hero" style={`--card-hue:${subject.hue}`}>
    <div class="wrap">
      <a class="back" href="/learn/">{learnUi.backToLearn}</a>
      <p class="kicker">{subject.subjectLabel}</p>
      <h1><span class="h-emoji">{subject.emoji}</span> {subject.title}</h1>
      <p class="subj-tag">{subject.tagline}</p>
      {subject.intro.map((p) => <p class="subj-intro" set:html={emphasize(p)} />)}
      <p class="subj-meta">
        {learnUi.topicCount(countTopics(subject))} · {learnUi.videoCount(countVideos(subject))} ·
        <span class="stars-inline">⭐ 모은 별 <strong data-total-stars>0</strong>개</span>
      </p>

      <nav class="toc" aria-label="이 과목의 주제">
        {subject.units.map((u) => (
          <div class="toc-group">
            <span class="toc-term">{u.term}</span>
            <ul>
              {u.topics.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  </section>

  {subject.units.map((unit) => (
    <section class="unit">
      <div class="wrap">
        <p class="section-label">{unit.term} · {unit.name}</p>

        {unit.topics.map((topic) => (
          <article class="topic" id={topic.id}>
            <h2>{topic.title}</h2>

            <div class="goal">
              <span class="goal-label">{learnUi.goalLabel}</span>
              <p set:html={emphasize(topic.goal)} />
            </div>

            <div class="points">
              <p class="points-label">{learnUi.pointsLabel}</p>
              <ul>{topic.points.map((p) => <li set:html={emphasize(p)} />)}</ul>
            </div>

            <p class="block-label">{learnUi.videosLabel}</p>
            <div class="vids">
              {topic.videos.map((v) => (
                <a class="vid" href={watchUrl(v.id)} target="_blank" rel="noopener noreferrer" title={learnUi.newTab}>
                  <span class="vid-thumb">
                    <img src={thumbUrl(v.id)} alt="" loading="lazy" width="320" height="180" />
                    <span class="vid-play">▶</span>
                    {v.len && <span class="vid-len">{v.len}</span>}
                  </span>
                  <span class="vid-body">
                    <strong class="vid-title">{v.title}</strong>
                    <span class="vid-ch">{v.channel}</span>
                  </span>
                </a>
              ))}
            </div>

            {topic.practice && (
              <>
                <p class="block-label">{learnUi.practiceLabel}</p>
                <LearnPractice kind={topic.practice} topicKey={`${subject.slug}:${topic.id}`} quiz={topic.quiz} />
              </>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="subj-next">
    <div class="wrap">
      <p class="section-label">다른 과목도 해 볼까요?</p>
      <div class="next-grid">
        {others.map((s) => (
          <a class="next-card" href={subjectUrl(s.slug)} style={`--card-hue:${s.hue}`}>
            <span class="next-emoji">{s.emoji}</span>
            <span><strong>{s.title}</strong><span class="next-tag">{s.tagline}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LearnScripts />
</BaseLayout>

<style>
  .subj-hero { padding: 40px 0 10px; }
  .back { display: inline-block; font-size: 14px; color: var(--muted); margin-bottom: 20px; }
  .back:hover { color: var(--accent); }
  .subj-hero h1 {
    font-family: var(--serif); font-weight: 600; font-size: clamp(2rem, 5.4vw, 3rem);
    color: var(--fg-strong); margin: 0 0 12px; letter-spacing: -0.01em;
  }
  .h-emoji { font-family: var(--sans); }
  .subj-tag { font-size: 1.15rem; color: var(--fg); margin: 0 0 20px; max-width: var(--readw); }
  .subj-intro { color: var(--muted); max-width: var(--readw); margin: 0 0 12px; }
  .subj-meta { color: var(--faint); font-size: 13.5px; margin: 18px 0 0; }
  .stars-inline strong { color: var(--accent); }

  .toc { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 26px; }
  /* ⚠️`min-width: 200px` 를 쓰면 좁은 화면에서 두 칸의 합이 뷰포트를 넘겨 **페이지 전체가
     가로로 밀린다**(430px 에서 본문 오른쪽이 잘렸다). flex-basis 로 주고 min-width 는 0 으로. */
  .toc-group { flex: 1 1 210px; min-width: 0; }
  .toc-term {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    color: hsl(var(--card-hue) 55% 55%); border: 1px solid hsl(var(--card-hue) 55% 55% / 0.4);
    border-radius: 999px; padding: 2px 10px; margin-bottom: 10px;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li { margin-bottom: 5px; }
  .toc a { color: var(--muted); font-size: 15px; }
  .toc a:hover { color: var(--accent); }

  .unit { padding: 46px 0 0; }
  .topic {
    padding: 30px 0 40px;
    border-top: 1px solid var(--border-soft);
    scroll-margin-top: 80px; /* sticky 헤더에 제목이 가리지 않도록 */
  }
  .topic:first-of-type { border-top: none; }
  .topic h2 {
    font-family: var(--serif); font-size: clamp(1.4rem, 4vw, 1.9rem);
    color: var(--fg-strong); margin: 0 0 18px;
  }

  .goal {
    display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline;
    padding: 14px 18px; border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    margin-bottom: 18px;
  }
  .goal-label { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--accent); flex: none; }
  .goal p { margin: 0; color: var(--fg-strong); font-size: 1.02rem; font-weight: 500; }

  .points { margin-bottom: 24px; }
  .points-label { font-size: 12px; letter-spacing: 0.1em; font-weight: 700; color: var(--faint); margin: 0 0 6px; text-transform: uppercase; }
  .points ul { margin: 0; padding-left: 20px; color: var(--muted); max-width: var(--readw); }
  .points li { margin-bottom: 6px; }

  .block-label {
    font-size: 12px; letter-spacing: 0.1em; font-weight: 700; color: var(--faint);
    margin: 0 0 10px; text-transform: uppercase;
  }
  .vids { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; margin-bottom: 26px; }
  .vid {
    display: flex; flex-direction: column; color: inherit; overflow: hidden;
    border: 1px solid var(--border); border-radius: 12px; background: var(--bg-elev);
    transition: transform .15s ease, border-color .15s ease;
  }
  .vid:hover { transform: translateY(-2px); border-color: var(--accent); color: inherit; }
  .vid-thumb { position: relative; display: block; aspect-ratio: 16 / 9; background: #10141b; overflow: hidden; }
  .vid-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vid-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 34px; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.65);
    background: rgba(8,10,18,.22); opacity: .9; transition: opacity .2s ease;
  }
  .vid:hover .vid-play { opacity: 1; background: rgba(8,10,18,.35); }
  .vid-len {
    position: absolute; right: 6px; bottom: 6px; font-size: 11px; font-weight: 600;
    color: #fff; background: rgba(0,0,0,.72); padding: 1px 6px; border-radius: 4px;
  }
  .vid-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; }
  .vid-title { font-size: 0.98rem; color: var(--fg-strong); font-weight: 600; line-height: 1.4; }
  .vid-ch { font-size: 12.5px; color: var(--faint); }

  .subj-next { padding: 20px 0 90px; }
  .next-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .next-card {
    display: flex; gap: 12px; align-items: center; color: inherit;
    padding: 16px 18px; border-radius: 14px; border: 1px solid var(--border);
    background: linear-gradient(160deg, hsl(var(--card-hue) 60% 50% / 0.10), transparent 70%), var(--bg-elev);
    transition: transform .15s ease, border-color .15s ease;
  }
  .next-card:hover { transform: translateY(-2px); border-color: hsl(var(--card-hue) 60% 50% / 0.55); color: inherit; }
  .next-emoji { font-size: 1.7rem; }
  .next-card strong { display: block; font-family: var(--serif); font-size: 1.1rem; color: var(--fg-strong); }
  .next-tag { display: block; font-size: 12.5px; color: var(--muted); margin-top: 2px; }
</style>
