---
// CKA 과정 홈 — 시험 요약 · 출제 비중 · 커리큘럼(진도 표시) · 8주 계획.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PARTS, DOMAIN_WEIGHTS, PLAN } from '../../../i18n/cka';
import { TASKS } from '../../../scripts/kubesim/tasks.js';
import '../../../styles/academy.css';

const all = (await getCollection('cka')).sort((a, b) => a.data.part - b.data.part || a.data.order - b.data.order);
const slugs = new Set(all.map((l) => l.id));
// ⚠️계획·과제가 없는 강의를 가리키면 빌드를 멈춘다(조용히 깨진 링크가 남지 않게)
for (const w of PLAN) for (const s of w.lessons) if (!slugs.has(s)) throw new Error(`PLAN 이 없는 강의를 가리킴: ${s}`);
for (const l of all) for (const id of l.data.labs) if (!TASKS.some((t) => t.id === id)) throw new Error(`${l.id} 강의가 없는 과제를 가리킴: ${id}`);
for (const t of TASKS) if (!slugs.has(t.lesson)) throw new Error(`과제 ${t.id} 가 없는 강의를 가리킴: ${t.lesson}`);
const planned = new Set(PLAN.flatMap((w) => w.lessons));
for (const l of all) if (!planned.has(l.id)) throw new Error(`8주 계획에 빠진 강의: ${l.id}`);

const totalMin = all.reduce((s, l) => s + l.data.minutes, 0);
const title = 'CKA 합격반 — 쿠버네티스 관리자 자격증';
const description = `CKA(Certified Kubernetes Administrator) 합격 준비. 기초부터 강의 ${all.length}개, 브라우저 실습 터미널 과제 ${TASKS.length}개(자동 채점), 2시간 실전 모의고사. 2025년 개정 교과과정(Helm·Kustomize·Gateway API) 반영.`;
const ld = {
  '@context': 'https://schema.org', '@type': 'Course', name: 'CKA 합격반', description, inLanguage: 'ko',
  provider: { '@type': 'Organization', name: 'MENEW', sameAs: 'https://menewsoft.com' },
  isAccessibleForFree: true,
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: `PT${Math.round(totalMin / 60)}H` },
};
---
<BaseLayout lang="ko" titleFull="CKA 합격반 — 쿠버네티스 관리자 자격증 무료 강의·실습·모의고사" description={description} canonicalPath="/academy/cka/" jsonLd={ld}>
  <main class="acad" data-tasks={JSON.stringify(TASKS.map((t) => t.id))}>
    <p class="crumbs"><a href="/academy/">자격증 학원</a> › CKA</p>
    <p class="kick">CERTIFIED KUBERNETES ADMINISTRATOR</p>
    <h1>☸️ CKA 합격반</h1>
    <p class="lead">
      쿠버네티스를 처음 만지는 사람도 <b>기초 → 영역별 실력 → 실전</b> 순서로 합격까지 갈 수 있게 만든 무료 과정입니다.
      강의 {all.length}개(약 {Math.round(totalMin / 60)}시간) · 실습 과제 {TASKS.length}개 · 실전 모의고사.
    </p>
    <div class="btns">
      <a class="btn pri" id="go-next" href={`/academy/cka/${all[0].id}/`}>처음부터 시작하기 →</a>
      <a class="btn" href="/academy/cka/lab/">⌨️ 실습 터미널</a>
      <a class="btn" href="/academy/cka/exam/">⏱ 모의고사</a>
    </div>
    <div class="prog" aria-label="진도"><div class="bar"><i id="pbar"></i></div><b id="ptext">0 / {all.length} 강의</b></div>
    <p class="small muted" id="plabs" style="margin:6px 0 0"></p>

    <h2>시험 요약</h2>
    <div class="grid">
      <div class="card"><h3>형식</h3><p class="muted small" style="margin:0">100% 실기. 원격 감독 아래 실제 리눅스 터미널로 클러스터를 만지고, 최종 상태를 채점.</p></div>
      <div class="card"><h3>시간 · 합격선</h3><p class="muted small" style="margin:0"><b>2시간</b>, 과제 약 15~20개, <b>66%</b> 이상 합격. 문항마다 부분 점수.</p></div>
      <div class="card"><h3>참고 자료</h3><p class="muted small" style="margin:0">허용된 공식 문서(kubernetes.io/docs 등)만. 재응시 1회, 연습 시뮬레이터(killer.sh) 2회 포함.</p></div>
    </div>
    <p class="note">응시료·허용 문서·버전 같은 세부 규정은 바뀝니다. 결제 전과 시험 직전에 <a href="https://training.linuxfoundation.org/certification/certified-kubernetes-administrator-cka/" rel="noopener" target="_blank">공식 시험 페이지</a>를 다시 확인하세요.</p>

    <h2>출제 영역과 비중</h2>
    <div class="card">
      {DOMAIN_WEIGHTS.map((d) => (
        <div class="dom"><span class="t">{d.ko}</span><span class="v" style={`width:${d.pct * 3.2}%`}></span><span class="n">{d.pct}%</span></div>
      ))}
      <p class="small muted" style="margin:10px 0 0">2025년 2월 개정 교과과정 기준. 트러블슈팅과 아키텍처가 절반이 넘습니다.</p>
    </div>

    <h2>커리큘럼</h2>
    {PARTS.map((p) => {
      const ls = all.filter((l) => l.data.part === p.n);
      return (
        <section class="part">
          <div class="part-h"><span class="no">PART {p.n}</span><h3 style="margin:0">{p.title}</h3>{'domain' in p && <span class="pill k8s">{DOMAIN_WEIGHTS.find((d) => d.key === (p as any).domain)?.pct}%</span>}<p>{p.blurb}</p></div>
          <ul class="lessons">
            {ls.map((l) => (
              <li data-slug={l.id}>
                <a href={`/academy/cka/${l.id}/`}>
                  <span class="st" aria-hidden="true">✓</span>
                  <span><span class="tt">{l.data.title}</span><span class="ss">{l.data.summary}</span></span>
                  <span class="meta"><span class="pill">{l.data.minutes}분</span>{l.data.labs.length > 0 && <span class="pill k8s">실습 {l.data.labs.length}</span>}<span class="pill q" hidden></span></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <h2>8주 학습 계획</h2>
    <p class="muted small">하루 1~2시간 기준입니다. 쿠버네티스를 써 본 적이 있으면 두 주씩 묶어 4주로 줄여도 됩니다.</p>
    <div class="tablewrap card" style="padding:6px 10px">
      <table>
        <thead><tr><th>주</th><th>목표</th><th>강의</th><th>이번 주 요령</th></tr></thead>
        <tbody>
          {PLAN.map((w) => (
            <tr>
              <td><b>{w.week}주</b></td>
              <td>{w.focus}</td>
              <td class="small">{w.lessons.map((s, i) => <>{i > 0 && ' · '}<a href={`/academy/cka/${s}/`}>{all.find((l) => l.id === s)!.data.title}</a></>)}</td>
              <td class="small muted">{w.tip}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="note">
      진도·퀴즈 점수·실습 기록은 이 브라우저에만 저장됩니다. ·
      실습 터미널은 쿠버네티스의 판단 규칙을 재현한 <b>시뮬레이터</b>입니다. 시험 전에는 <a href="/academy/cka/lab-setup/">진짜 클러스터</a>에서도 꼭 손을 풀어 두세요. ·
      과제는 공개 교과과정을 바탕으로 새로 만든 문제이며 기출이 아닙니다.
      <button type="button" class="btn sm" id="reset" style="margin-left:6px">진도 초기화</button>
    </p>
  </main>
  <script>
    import { load, reset } from '../../../scripts/cka-progress.js';
    // ⚠️과제 목록은 data 속성으로 받는다 — tasks.js 를 import 하면 시뮬레이터 전체(수백 KB)가 딸려 온다
    const TASK_IDS: string[] = JSON.parse(document.querySelector('main.acad')!.getAttribute('data-tasks') || '[]');
    function paint() {
      const p = load();
      const items = [...document.querySelectorAll('.lessons li')];
      let done = 0, next = null;
      for (const li of items) {
        const slug = li.dataset.slug;
        const ok = !!p.lessons[slug];
        li.classList.toggle('done', ok);
        if (ok) done++; else if (!next) next = li;
        const q = p.quiz[slug];
        const pill = li.querySelector('.pill.q');
        if (q) { pill.hidden = false; pill.textContent = `퀴즈 ${q.got}/${q.total}`; pill.classList.toggle('ok', q.got === q.total); }
      }
      document.getElementById('pbar').style.width = `${(done / items.length) * 100}%`;
      document.getElementById('ptext').textContent = `${done} / ${items.length} 강의`;
      const labsDone = TASK_IDS.filter((id) => p.labs[id] === 1).length;
      const ex = p.exams.slice(-1)[0];
      document.getElementById('plabs').textContent = `실습 만점 ${labsDone} / ${TASK_IDS.length}` + (ex ? ` · 최근 모의고사 ${ex.score}%` : '');
      const go = document.getElementById('go-next');
      if (done && next) { go.href = next.querySelector('a').getAttribute('href'); go.textContent = `이어서: ${next.querySelector('.tt').textContent} →`; }
      else if (done && !next) { go.href = '/academy/cka/exam/'; go.textContent = '강의 완료! 모의고사 보기 →'; }
    }
    paint();
    document.getElementById('reset').addEventListener('click', () => { if (confirm('이 브라우저의 CKA 진도·기록을 모두 지울까요?')) { reset(); paint(); } });
  </script>
</BaseLayout>
