---
// CKA 모의고사 — 영역 비중대로 과제를 뽑아 2시간 · 부분 점수 · 66% 합격선으로 친다.
// 과제마다 독립된 클러스터를 쓴다(한 문제의 실수가 다른 문제 채점에 번지지 않게).
// ⚠️진행 중 상태(클러스터)는 메모리에만 있다 — 새로고침하면 사라진다(페이지에서 경고한다).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TASKS } from '../../../scripts/kubesim/tasks.js';
import { getCollection } from 'astro:content';
const lessonTitles = Object.fromEntries((await getCollection('cka')).map((l) => [l.id, l.data.title]));
import '../../../styles/academy.css';
const pool = TASKS.filter((t) => t.domain !== 'basics').length;
---
<BaseLayout lang="ko" title="모의고사 — CKA 합격반" description={`실제 CKA 처럼 2시간, 출제 비중대로 뽑은 실기 과제, 항목별 부분 점수, 66% 합격선. 과제 은행 ${pool}개에서 매번 새로 뽑는다.`} canonicalPath="/academy/cka/exam/">
  <main class="acad wide" data-lessons={JSON.stringify(lessonTitles)}>
    <p class="crumbs"><a href="/academy/">자격증 학원</a> › <a href="/academy/cka/">CKA</a> › 모의고사</p>

    <section id="intro">
      <h1>⏱ CKA 모의고사</h1>
      <p class="lead">실제 시험처럼 치르고, 끝나면 영역별로 어디가 약한지 알려 줍니다. 과제 은행 {pool}개에서 매번 새로 뽑습니다.</p>
      <div class="grid">
        <div class="card">
          <h3>실전형</h3>
          <p class="muted small">16문항 · <b>120분</b> · 영역 비중대로(트러블슈팅 5 · 아키텍처 4 · 네트워킹 3 · 워크로드 3 · 스토리지 1)</p>
          <button class="btn pri" data-mode="full">실전형 시작</button>
        </div>
        <div class="card">
          <h3>하프</h3>
          <p class="muted small">8문항 · <b>60분</b> · 짧게 실력 점검</p>
          <button class="btn" data-mode="half">하프 시작</button>
        </div>
      </div>
      <div class="note">
        <b>규칙</b> — 힌트·모범 답안은 없습니다. 문항마다 독립된 클러스터가 준비됩니다. 채점은 끝낸 순간의 <b>최종 상태</b>로, 항목별 부분 점수가 있습니다. 합격선 66%.
        시간이 다 되면 자동으로 채점합니다. <b>새로고침하거나 페이지를 떠나면 진행 상황이 사라집니다.</b>
        시험장처럼 필요하면 새 탭에서 <a href="https://kubernetes.io/docs/" target="_blank" rel="noopener">kubernetes.io/docs</a> 를 보면서 푸세요.
      </div>
      <div id="history"></div>
    </section>

    <section id="run" hidden>
      <div class="card" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:12px 14px;margin-bottom:14px">
        <span class="timer" id="timer">120:00</span>
        <div class="qnav" id="qnav"></div>
        <span style="flex:1"></span>
        <button class="btn sm" id="flag">🚩 표시</button>
        <button class="btn sm pri" id="finish">시험 종료 · 채점</button>
      </div>
      <div class="lab">
        <div class="side">
          <div class="card task" id="q"></div>
        </div>
        <div class="termbox"><div id="term"></div></div>
      </div>
    </section>

    <section id="done" hidden></section>
    <p id="cka-test" class="small muted" hidden></p>
  </main>
  <script>
    import { Cluster } from '../../../scripts/kubesim/engine.js';
    import { Session } from '../../../scripts/kubesim/shell.js';
    import { TASKS, DOMAINS, prepareTask, applyStep, score } from '../../../scripts/kubesim/tasks.js';
    import { Terminal, TERM_CSS } from '../../../scripts/cka-terminal.js';
    import { load, saveExam, saveLab, fmt, esc } from '../../../scripts/cka-progress.js';

    const st = document.createElement('style'); st.textContent = TERM_CSS; document.head.appendChild(st);
    const $ = (id: string) => document.getElementById(id)!;
    const LESSONS: Record<string, string> = JSON.parse(document.querySelector('main.acad')!.getAttribute('data-lessons') || '{}');
    const MODES: any = {
      full: { minutes: 120, counts: { trouble: 5, arch: 4, network: 3, workloads: 3, storage: 1 } },
      half: { minutes: 60, counts: { trouble: 3, arch: 2, network: 1, workloads: 1, storage: 1 } },
    };
    let exam: any = null, term: Terminal | null = null, tick: any = null;

    function shuffle<T>(a: T[]): T[] { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
    function paintHistory() {
      const ex = load().exams.slice(-5).reverse();
      $('history').innerHTML = ex.length ? `<h2>지난 기록</h2><div class="tablewrap card" style="padding:6px 10px"><table><thead><tr><th>날짜</th><th>유형</th><th>점수</th><th>결과</th></tr></thead><tbody>${ex.map((e: any) => `<tr><td>${new Date(e.at).toLocaleString('ko-KR')}</td><td>${e.mode === 'full' ? '실전형' : '하프'}</td><td><b>${e.score}%</b></td><td>${e.score >= 66 ? '<span class="pill ok">합격권</span>' : '<span class="pill">미달</span>'}</td></tr>`).join('')}</tbody></table></div>` : '';
    }

    function start(mode: string) {
      const m = MODES[mode];
      const items: any[] = [];
      for (const [dom, n] of Object.entries(m.counts) as [string, number][]) {
        const picked = shuffle(TASKS.filter((t: any) => t.domain === dom)).slice(0, n);
        for (const t of picked) items.push({ task: t, pts: (DOMAINS as any)[dom].weight / n, env: null, html: '', flag: false, seen: false });
      }
      exam = { mode, items: shuffle(items), cur: 0, ends: Date.now() + m.minutes * 60000, minutes: m.minutes };
      $('intro').hidden = true; $('done').hidden = true; $('run').hidden = false;
      if (!term) term = new Terminal($('term'));
      $('qnav').innerHTML = exam.items.map((_: any, i: number) => `<button type="button" data-i="${i}">${i + 1}</button>`).join('');
      show(0);
      clearInterval(tick);
      tick = setInterval(timer, 1000); timer();
      addEventListener('beforeunload', guard);
    }
    function guard(e: BeforeUnloadEvent) { if (exam && !exam.finished) { e.preventDefault(); e.returnValue = ''; } }
    function timer() {
      const left = Math.max(0, exam.ends - Date.now());
      const m = Math.floor(left / 60000), s = Math.floor((left % 60000) / 1000);
      const el = $('timer');
      el.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      el.classList.toggle('low', left < 10 * 60000);
      if (!left) finish();
    }
    function show(i: number) {
      const prev = exam.items[exam.cur];
      if (prev && prev.env) prev.html = (document.querySelector('#term .term-out') as HTMLElement).innerHTML;
      exam.cur = i;
      const it = exam.items[i];
      it.seen = true;
      const firstTime = !it.env;
      if (!it.env) it.env = prepareTask(it.task, Cluster, Session);
      term!.setSession(it.env.session, firstTime ? `# 문항 ${i + 1} — 이 문항 전용 클러스터가 준비됐습니다.` : '');
      if (!firstTime) { (document.querySelector('#term .term-out') as HTMLElement).innerHTML = it.html; term!.prompt(); }
      const dm = (DOMAINS as any)[it.task.domain];
      $('q').innerHTML = `<p class="kick">문항 ${i + 1} / ${exam.items.length} · 배점 ${Math.round(it.pts * 10) / 10}% · ${esc(dm.ko)}</p>
        <h3>${esc(it.task.title)}</h3>
        <p class="ctx">controlplane:~# 에서 시작 — 노드 작업은 ssh 로 이동</p>
        <div class="txt">${fmt(it.task.text)}</div>
        <div class="btns">${i > 0 ? '<button class="btn sm" id="qprev">← 이전</button>' : ''}${i < exam.items.length - 1 ? '<button class="btn sm pri" id="qnext">다음 문항 →</button>' : '<button class="btn sm pri" id="qend">마지막 문항 — 종료하기</button>'}</div>`;
      if ($('q').querySelector('#qprev')) $('qprev').onclick = () => show(i - 1);
      if ($('q').querySelector('#qnext')) $('qnext').onclick = () => show(i + 1);
      if ($('q').querySelector('#qend')) $('qend').onclick = () => ask();
      paintNav();
      if (!matchMedia('(max-width: 900px), (pointer: coarse)').matches) term!.focus();
    }
    function paintNav() {
      document.querySelectorAll<HTMLButtonElement>('#qnav button').forEach((b, k) => {
        const it = exam.items[k];
        b.classList.toggle('cur', k === exam.cur); b.classList.toggle('flag', it.flag); b.classList.toggle('seen', it.seen);
      });
      $('flag').textContent = exam.items[exam.cur].flag ? '🚩 표시 해제' : '🚩 표시';
    }
    function ask() { const un = exam.items.filter((x: any) => !x.seen).length; if (confirm(un ? `아직 열어 보지 않은 문항이 ${un}개 있습니다. 그래도 종료할까요?` : '시험을 종료하고 채점할까요?')) finish(); }
    function finish() {
      if (!exam || exam.finished) return;
      exam.finished = true;
      clearInterval(tick);
      removeEventListener('beforeunload', guard);
      let total = 0;
      const dom: any = {};
      const rows = exam.items.map((it: any, i: number) => {
        const r = it.env ? score(it.task, it.env.cluster, it.env.session) : { items: [], got: 0, total: 1, ratio: 0 };
        const got = it.pts * r.ratio;
        total += got;
        const d = (dom[it.task.domain] = dom[it.task.domain] || { got: 0, max: 0 });
        d.got += got; d.max += it.pts;
        if (it.env) saveLab(it.task.id, r.ratio);
        return { it, r, got, i };
      });
      const pct = Math.round(total);
      const used = Math.round((exam.minutes * 60000 - Math.max(0, exam.ends - Date.now())) / 60000);
      saveExam({ at: Date.now(), mode: exam.mode, score: pct, minutes: used });
      $('run').hidden = true;
      const dn = $('done');
      dn.hidden = false;
      const weak = Object.entries(dom).filter(([, v]: any) => v.got / v.max < 0.66).map(([k]) => (DOMAINS as any)[k].ko);
      dn.innerHTML = `<h1>${pct >= 66 ? '🎉 합격권입니다' : '📘 조금 더 준비해요'}</h1>
        <div class="grid">
          <div class="card"><p class="kick">총점</p><p class="score-big" id="final-score">${pct}%</p><p class="muted small" style="margin:6px 0 0">합격선 66% · ${used}분 사용</p></div>
          <div class="card"><p class="kick">영역별</p>${Object.entries(dom).map(([k, v]: any) => `<div class="dom"><span class="t">${esc((DOMAINS as any)[k].ko)}</span><span class="v" style="width:${Math.max(2, (v.got / v.max) * 100)}%;${v.got / v.max < 0.66 ? 'background:var(--bad)' : ''}"></span><span class="n">${Math.round((v.got / v.max) * 100)}%</span></div>`).join('')}</div>
        </div>
        ${weak.length ? `<p class="note">약한 영역: <b>${weak.map(esc).join(', ')}</b> — 해당 강의를 다시 보고 실습 과제를 반복하세요.</p>` : ''}
        <h2>문항별 결과</h2>
        <div class="tablewrap card" style="padding:6px 10px"><table><thead><tr><th>#</th><th>과제</th><th>득점</th><th>채점 항목</th><th></th></tr></thead><tbody>
        ${rows.map(({ it, r, got, i }: any) => `<tr><td>${i + 1}</td><td><b>${esc(it.task.title)}</b><br><span class="small muted">${esc((DOMAINS as any)[it.task.domain].ko)}</span></td><td><b>${Math.round(got * 10) / 10}</b> / ${Math.round(it.pts * 10) / 10}</td><td class="small">${it.env ? r.items.map((x: any) => `${x.ok ? '✅' : '❌'} ${esc(x.t)}`).join('<br>') : '<span class="muted">열어 보지 않음</span>'}</td><td class="small"><a href="/academy/cka/lab/?task=${it.task.id}">다시 풀기</a><br><a href="/academy/cka/${it.task.lesson}/" title="${esc(LESSONS[it.task.lesson] || '')}">강의</a></td></tr>`).join('')}
        </tbody></table></div>
        <div class="btns"><button class="btn pri" id="again">새 모의고사</button><a class="btn" href="/academy/cka/">과정 목차</a></div>`;
      $('again').onclick = () => { exam = null; dn.hidden = true; $('intro').hidden = false; paintHistory(); scrollTo(0, 0); };
      scrollTo(0, 0);
      return pct;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => start(b.dataset.mode!)));
    $('qnav').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) show(Number(b.dataset.i)); });
    $('flag').addEventListener('click', () => { exam.items[exam.cur].flag = !exam.items[exam.cur].flag; paintNav(); });
    $('finish').addEventListener('click', ask);
    paintHistory();

    // ── 자가검증(?test=cka) ──
    if (new URLSearchParams(location.search).get('test') === 'cka') {
      const fails: string[] = [];
      (window as any).confirm = () => true;
      start('full');
      if (exam.items.length !== 16) fails.push(`문항 수 ${exam.items.length}`);
      const sum = exam.items.reduce((s: number, x: any) => s + x.pts, 0);
      if (Math.abs(sum - 100) > 0.01) fails.push(`배점 합 ${sum}`);
      if (!/^1[12]\d:|^120:00|^119:/.test($('timer').textContent || '')) fails.push(`타이머 ${$('timer').textContent}`);
      // 앞 8문항은 모범 답안으로 풀고, 나머지는 손대지 않는다 → 점수가 대략 절반 근처여야 한다
      // 기대 점수 = 푼 문항은 만점 + 안 푼 문항은 준비 상태에서 이미 맞는 항목만큼(부분 점수)
      let expect = 0;
      exam.items.forEach((it: any, i: number) => {
        show(i);
        if (i < 8) { for (const s of it.task.solution) applyStep(it.env.session, s); expect += it.pts; }
        else expect += it.pts * score(it.task, it.env.cluster, it.env.session).ratio;
      });
      show(0);
      if (!document.querySelector('#term .term-out')!.textContent!.includes('문항 1')) fails.push('문항 전환 시 터미널 기록 복원 실패');
      const pct = finish();
      document.querySelectorAll('#done tbody tr').forEach((tr, i) => { if (i < 8 && /❌/.test(tr.textContent || '')) fails.push(`푼 문항 ${i + 1} 이 만점이 아님`); });
      if (Math.abs(pct - Math.round(expect)) > 1) fails.push(`점수 ${pct} ≠ 기대 ${Math.round(expect)}`);
      if (!document.getElementById('final-score')) fails.push('결과 화면 없음');
      if (document.querySelectorAll('#done tbody tr').length !== 16) fails.push('결과 표 행 수');
      if (load().exams.slice(-1)[0].score !== pct) fails.push('기록 저장');
      const W = document.documentElement.clientWidth;
      if (document.documentElement.scrollWidth > W + 1) fails.push(`가로 넘침 ${document.documentElement.scrollWidth}>${W}`);
      const out = $('cka-test'); out.hidden = false; out.textContent = fails.length ? 'FAIL\n' + fails.join('\n') : 'PASS';
      document.title = (fails.length ? 'CKA-TEST FAIL ' : 'CKA-TEST PASS ') + fails.length;
    }
  </script>
</BaseLayout>
