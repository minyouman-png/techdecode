---
// 등록 업체 소식 — 블로그가 있던 자리를 대신하는 섹션(2026-08-05).
//
// ⚠️★이 페이지의 유일한 규칙: **소식의 출처를 반드시 밝힌다.**
//   두 종류만 싣는다. ①가게가 작성기로 직접 올린 공지(`src/data/shop-notices/<slug>.json`)
//   ②공개 자료에서 확인한 소식(`shops.ts` 의 `news`, 출처 링크가 타입상 필수).
//   우리가 지어낸 소식은 여기에 들어오지 못한다 — 손님이 그걸 믿고 헛걸음하면 가게가 피해를 본다.
//   두 종류는 배지로 구분해 표시한다. 섞이면 ②가 가게 명의 공지처럼 읽힌다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, isNoindexLang, type Lang } from '../i18n/ui';
import { useTranslations, localizeUrl } from '../i18n/utils';
import { shops, shopCopy, shopUrl, allShopNews } from '../i18n/shops';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const alternates = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((l) => [l, localizeUrl('/news/', l)])
) as Partial<Record<Lang, string>>;

// 가게가 직접 올린 공지. blocks 는 안전한 구조체만 허용하므로(원시 HTML 금지) 여기서는
// 목록용으로 첫 텍스트 블록만 요약해 쓰고, 본문은 가게 페이지에서 보여준다.
const noticeFiles = import.meta.glob<{ notices?: any[] }>('../data/shop-notices/*.json', { eager: true });
const shopNotices = shops.flatMap((shop) => {
  const data = noticeFiles[`../data/shop-notices/${shop.slug}.json`];
  const c = shopCopy(shop, lang);
  return (data?.notices ?? [])
    .filter((n: any) => n && n.title)
    .map((n: any) => {
      const firstText = (n.blocks ?? []).find((b: any) => b?.type === 'text' && b.text);
      return {
        origin: 'shop' as const,
        date: String(n.date ?? ''),
        title: String(n.title),
        text: firstText ? String(firstText.text) : '',
        shopName: c.name,
        shopHref: shopUrl(shop.slug, lang),
        source: null as null | { label: string; url: string },
      };
    });
});

const pressNews = allShopNews(lang).map((n) => ({
  origin: 'press' as const,
  date: n.date,
  title: '',
  text: n.text,
  shopName: n.shopName,
  shopHref: shopUrl(n.shop.slug, lang),
  source: n.source,
}));

const rows = [...shopNotices, ...pressNews].sort((a, b) => (a.date < b.date ? 1 : -1));
---
{/* ⚠️★2026-08-20: 기계번역 언어(ja·es·zh)는 색인에서 뺀다. 원주의 동네 가게를
    일본어·중국어·스페인어로 찾는 사람은 없고, 번역된 소개문만 자동생성 티가 난다.
    한국어(고객)와 영어(국내 거주 외국인)만 검색에 내보낸다. `noindexLangs` 참조. */}
<BaseLayout lang={lang} title={t('news_title')} description={t('news_desc')} alternates={alternates}
  robots={isNoindexLang(lang) ? 'noindex, follow' : undefined}>
  <section class="news-hero">
    <div class="wrap">
      <p class="kicker">{t('dir_title')}</p>
      <h1>{t('news_title')}</h1>
      <p class="news-lede">{t('news_desc')}</p>
    </div>
  </section>

  <section class="news-body">
    <div class="wrap">
      {rows.length === 0 ? (
        <p class="news-empty">{t('news_empty')}</p>
      ) : (
        <ol class="news-feed">
          {rows.map((row) => (
            <li class="news-item">
              <div class="news-meta">
                <span class={`badge ${row.origin}`}>
                  {row.origin === 'shop' ? t('news_badge_shop') : t('news_badge_press')}
                </span>
                <a class="news-shop" href={row.shopHref}>{row.shopName}</a>
                <time class="news-when">{row.date}</time>
              </div>
              {row.title && <h2 class="news-title">{row.title}</h2>}
              {row.text && <p class="news-text">{row.text}</p>}
              <div class="news-foot">
                {row.source && (
                  <a class="news-src" href={row.source.url} target="_blank" rel="noopener nofollow">
                    {t('news_source')}: {row.source.label} ↗
                  </a>
                )}
                <a class="news-more" href={row.shopHref}>{t('news_shop_link')}</a>
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>


{/* 스타일은 global.css 의 `업체 소식` 절에 있다(디자인 토큰 일관성 유지). */}
